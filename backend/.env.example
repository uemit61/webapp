# --- Vorlage fuer backend/.env ---
# Kopiere diese Datei zu "backend/.env" und trage echte Werte ein.
# Die echte .env wird NICHT eingecheckt (siehe .gitignore).

# Django
# SECRET_KEY erzeugen:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=dein-geheimer-django-key
# FERNET_KEY erzeugen:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=dein-fernet-key
DJANGO_DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_ALLOWED_ORIGINS=http://localhost:3000

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dein-db-passwort
POSTGRES_DB=ccdb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
